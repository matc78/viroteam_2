      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": [
    {
      "database": "v2-dev",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "v2-prod",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
