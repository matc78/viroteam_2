rules_version = '2';

// Règles Firestore ViroTeam v2 — appliquées aux bases `v2-dev` et `v2-prod`
// (voir firebase.json). Tests : `cd rules-tests && npm test`.
//
// Principes (lot 1 sécurité, 2 sept. 2026) :
// - Tout ce qui touche aux rôles, aux comptes liés et aux invitations acceptées
//   passe par les Cloud Functions (Admin SDK). Les clients ne font que lire.
// - Un membre ne modifie que son profil (liste blanche de champs).
// - Une invitation n'est lisible que par le club (coach/admin) ou par l'e-mail invité.
//   La recherche par code passe par la callable `lookupInvitationByCode`.
// - Un parent (guardian) ne voit que les équipes de ses enfants et ce qui les concerne
//   (`users/{uid}.parentTeamIds`, maintenu côté serveur).
//
// Lot 2 (revue chat / parents, 28 sept. 2026) :
// - Un parent ne lit une fiche membre que si c'est son enfant, un membre des
//   équipes de ses enfants (coach, coéquipier) ou un admin (cible de DM).
//   `member_accounts` : `get` seul pour un parent (résolution uid → fiche), pas de `list`.
// - Conversation : rename réservé aux participants qui ont le droit d'écrire,
//   `titleOverride` string ≤ 80 (ou null pour effacer) ; preview inbox bornée.
// - Message : liste fermée de champs à la création, `createdAt` = horodatage
//   serveur, `reactions` / `pollVotes` vides, texte ≤ 4000, médias image
//   obligatoirement dans le bucket du projet sous `…/chat/{conv}/{auth.uid}/`.
// - `activity_events` : `type` parmi la liste connue, `summary` ≤ 200.

service cloud.firestore {
  match /databases/{database}/documents {

    // ————————————————————————————————————————————————————————————
    // Helpers identité
    // ————————————————————————————————————————————————————————————

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// E-mail du compte connecté, normalisé (minuscules). Chaîne vide si absent.
    function authEmail() {
      return isSignedIn() && request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // ————————————————————————————————————————————————————————————
    // Appartenance au club
    // ————————————————————————————————————————————————————————————

    function memberDocRef(clubId) {
      let accountIndex = /databases/$(database)/documents/clubs/$(clubId)/member_accounts/$(request.auth.uid);
      return exists(accountIndex)
        ? /databases/$(database)/documents/clubs/$(clubId)/members/$(get(accountIndex).data.memberId)
        : /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubMember(clubId) {
      return isSignedIn() && exists(memberDocRef(clubId));
    }

    function clubMemberRole(clubId) {
      return get(memberDocRef(clubId)).data.role;
    }

    function isInClubAdminIds(clubId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId))
          .data.get('adminIds', []);
    }

    /// Comme [isInClubAdminIds], mais sur l'état **après** les écritures du
    /// batch/transaction (`getAfter`). Nécessaire pour le parcours club-setup :
    /// club + fiche admin fondateur sont créés dans la même transaction, et
    /// `get()`/`exists()` ne voient que l'état **avant** (club encore absent).
    function isInClubAdminIdsAfter(clubId) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/clubs/$(clubId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/clubs/$(clubId))
          .data.get('adminIds', []);
    }

    function isClubAdmin(clubId) {
      return isSignedIn() && (
        (isClubMember(clubId) && clubMemberRole(clubId) == 'admin')
        || isInClubAdminIds(clubId)
      );
    }

    function isClubCoach(clubId) {
      return isSignedIn() && isClubMember(clubId) && clubMemberRole(clubId) == 'coach';
    }

    function isClubCoachOrAdmin(clubId) {
      return isClubAdmin(clubId) || isClubCoach(clubId);
    }

    /// Le compte connecté est le titulaire de la fiche `memberId`
    /// (fiche à son uid, ou index `member_accounts` qui pointe vers elle).
    function ownsMemberDoc(clubId, memberId) {
      return isOwner(memberId)
        || (isSignedIn()
          && exists(/databases/$(database)/documents/clubs/$(clubId)/member_accounts/$(request.auth.uid))
          && get(/databases/$(database)/documents/clubs/$(clubId)/member_accounts/$(request.auth.uid)).data.memberId == memberId);
    }

    function audienceMemberId(clubId) {
      let accountIndex = /databases/$(database)/documents/clubs/$(clubId)/member_accounts/$(request.auth.uid);
      return exists(accountIndex)
        ? get(accountIndex).data.memberId
        : request.auth.uid;
    }

    // ————————————————————————————————————————————————————————————
    // Parents (guardians)
    // ————————————————————————————————————————————————————————————

    function guardianDoc(clubId, memberId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(memberId)/guardians/$(request.auth.uid);
    }

    function isActiveGuardianOf(clubId, memberId) {
      return isSignedIn()
        && exists(guardianDoc(clubId, memberId))
        && get(guardianDoc(clubId, memberId)).data.status == 'active';
    }

    function isClubGuardian(clubId) {
      return isSignedIn()
        && exists(userDoc())
        && clubId in get(userDoc()).data.get('parentClubIds', []);
    }

    /// Équipes des enfants du parent connecté (maintenu par les Cloud Functions).
    function parentTeamIds() {
      return exists(userDoc()) ? get(userDoc()).data.get('parentTeamIds', []) : [];
    }

    function guardianCanSeeTeams(clubId, teamIds) {
      return isClubGuardian(clubId) && teamIds.hasAny(parentTeamIds());
    }

    /// Fiche membre visible d'un parent (hors ses propres enfants, couverts par
    /// `isActiveGuardianOf`) : membre d'une équipe de ses enfants (coach,
    /// coéquipier du roster) ou admin du club (cible possible d'un DM).
    function guardianCanSeeMember(clubId) {
      return isClubGuardian(clubId) && (
        resource.data.get('teamIds', []).hasAny(parentTeamIds())
        || resource.data.get('role', '') == 'admin'
      );
    }

    /// Annonce visible d'un parent : tout le club, ou une équipe de ses enfants.
    function guardianCanSeeAnnouncement(clubId) {
      return isClubGuardian(clubId) && (
        resource.data.get('targetType', 'Tous les membres') in ['Tous les membres', 'all']
        || (resource.data.get('targetType', '') == 'Équipes'
          && resource.data.get('targetIds', []).hasAny(parentTeamIds()))
      );
    }

    // ————————————————————————————————————————————————————————————
    // Helpers de mutation
    // ————————————————————————————————————————————————————————————

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /// RSVP : le membre ne peut modifier que sa propre clé dans `rsvp`.
    function onlyOwnRsvpUpdate(clubId) {
      let rsvpAffected = request.resource.data.get('rsvp', {})
        .diff(resource.data.get('rsvp', {})).affectedKeys();
      return isClubMember(clubId)
        && affectedKeys().hasOnly(['rsvp', 'updatedAt'])
        && rsvpAffected.hasOnly([audienceMemberId(clubId)]);
    }

    /// Le titulaire d'une fiche ne modifie que son profil affiché.
    function isOwnProfileUpdate(clubId, memberId) {
      return ownsMemberDoc(clubId, memberId)
        && affectedKeys().hasOnly([
          'firstName', 'lastName', 'snapshot', 'dismissedAnnouncementIds', 'updatedAt'
        ]);
    }

    /// Un coach gère les équipes et les infos sportives, pas les rôles ni les comptes.
    function isCoachMemberUpdate(clubId) {
      return isClubCoach(clubId)
        && !affectedKeys().hasAny([
          'role', 'status', 'accountUid', 'userId', 'activeInvitationId', 'memberId'
        ]);
    }

    /// L'invité (même e-mail) décline son invitation.
    function isInviteeDeclining() {
      return isSignedIn()
        && authEmail() != ''
        && resource.data.get('email', '') == authEmail()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'declined'
        && affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isInvitee() {
      return isSignedIn()
        && authEmail() != ''
        && resource.data.get('email', '') == authEmail();
    }

    // ————————————————————————————————————————————————————————————
    // users
    // ————————————————————————————————————————————————————————————

    match /users/{uid} {
      // get pour afficher coéquipiers ; pas de list global (scraping).
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.get('parentLinks', []) == []
        && request.resource.data.get('parentClubIds', []) == []
        && request.resource.data.get('parentTeamIds', []) == [];
      // Les index parent sont maintenus par les Cloud Functions.
      allow update: if isOwner(uid)
        && !affectedKeys().hasAny(['parentLinks', 'parentClubIds', 'parentTeamIds', 'deleted']);
      // Suppression de compte : callable `deleteMyAccount` (anonymisation).
      allow delete: if false;

      // Mute / unread chat (client).
      match /chatState/{stateId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ————————————————————————————————————————————————————————————
    // clubs
    // ————————————————————————————————————————————————————————————

    match /clubs/{clubId} {
      // Fondateur : il est le seul admin du club qu'il crée.
      allow create: if isSignedIn()
        && request.resource.data.get('adminIds', []) == [request.auth.uid];
      // L'aperçu « rejoindre par code » passe par `lookupInvitationByCode`.
      allow get: if isSignedIn();
      allow list: if isClubMember(clubId)
        || isClubGuardian(clubId)
        || (isSignedIn() && request.auth.uid in resource.data.get('adminIds', []));
      // `adminIds` n'est modifié que par les Cloud Functions (rôles, retrait, suppression).
      // Un coach qui pré-crée une fiche ne touche qu'au compteur.
      allow update: if (isClubAdmin(clubId) && !affectedKeys().hasAny(['adminIds']))
        || (isClubCoach(clubId) && affectedKeys().hasOnly(['memberCount', 'updatedAt']));
      allow delete: if false;

      // ——— Fiches membres ———
      match /members/{memberId} {
        // get : membres du club, parent de la fiche, ou parent du club limité
        // aux équipes de ses enfants / aux admins (roster via IDs lus sur
        // `teams` — pas de list). Avant : n'importe quelle fiche du club.
        allow get: if isClubMember(clubId)
          || isActiveGuardianOf(clubId, memberId)
          || guardianCanSeeMember(clubId);
        allow list: if isClubMember(clubId);
        // Création : coach/admin (fiche pré-créée + invitation) ou fondateur.
        // L'arrivée d'un invité passe par la callable `acceptInvitation`.
        // Fondateur : `isInClubAdminIdsAfter` couvre la transaction atomique
        // club + membre (sinon get() ne voit pas encore le club).
        allow create: if isClubCoachOrAdmin(clubId)
          || (isOwner(memberId) && isInClubAdminIds(clubId))
          || (isOwner(memberId)
            && request.resource.data.get('role', '') == 'admin'
            && isInClubAdminIdsAfter(clubId));
        allow update: if isClubAdmin(clubId)
          || isCoachMemberUpdate(clubId)
          || isOwnProfileUpdate(clubId, memberId);
        // Retrait d'un membre : callable `removeMember`.
        allow delete: if false;

        match /guardians/{parentUid} {
          // Lecture : membres du club, le parent lui-même, le titulaire de la fiche.
          // Écriture : Cloud Functions uniquement.
          allow read: if isClubMember(clubId)
            || isOwner(parentUid)
            || ownsMemberDoc(clubId, memberId);
          allow write: if false;
        }
      }

      // ——— Index compte → fiche (Cloud Functions uniquement) ———
      match /member_accounts/{accountUid} {
        // Parent : `get` seul — résout un uid Auth (adminIds / coachIds) vers
        // la fiche pour ses cibles de DM (new_conversation_sheet). Pas de
        // `list` : le doc ne contient que `memberId`, mais on ne donne pas
        // l'annuaire complet du club.
        allow get: if isClubMember(clubId)
          || isOwner(accountUid)
          || isClubGuardian(clubId);
        allow list: if isClubMember(clubId);
        allow write: if false;
      }

      // ——— Invitations ———
      match /invitations/{inviteId} {
        allow get, list: if isClubCoachOrAdmin(clubId) || isInvitee();
        // E-mail obligatoire ; un coach n'invite pas d'admin ; parents via Cloud Functions.
        allow create: if isClubCoachOrAdmin(clubId)
          && request.resource.data.get('type', 'member') != 'guardian'
          && request.resource.data.get('email', '') is string
          && request.resource.data.get('email', '').size() > 0
          && request.resource.data.get('status', '') == 'pending'
          && (
            request.resource.data.get('role', '') in ['player', 'coach']
            || (isClubAdmin(clubId) && request.resource.data.get('role', '') == 'admin')
          );
        allow update: if (isClubCoachOrAdmin(clubId)
            && request.resource.data.get('status', '') != 'accepted'
            && !affectedKeys().hasAny(['memberId', 'type']))
          || isInviteeDeclining();
        allow delete: if isClubAdmin(clubId);
      }

      // ——— Événements ———
      match /events/{eventId} {
        allow read: if isClubMember(clubId)
          || guardianCanSeeTeams(clubId, resource.data.get('teamIds', []));
        allow create: if isClubCoachOrAdmin(clubId);
        allow update: if isClubCoachOrAdmin(clubId) || onlyOwnRsvpUpdate(clubId);
        allow delete: if isClubAdmin(clubId);
      }

      // ——— Annonces ———
      match /announcements/{announcementId} {
        allow read: if isClubMember(clubId) || guardianCanSeeAnnouncement(clubId);
        allow create, update, delete: if isClubCoachOrAdmin(clubId);
      }

      // ——— Équipes ———
      match /teams/{teamId} {
        allow read: if isClubMember(clubId)
          || guardianCanSeeTeams(clubId, [teamId]);
        allow create, update: if isClubCoachOrAdmin(clubId);
        allow delete: if isClubAdmin(clubId);
      }

      // Inventaire simple (CRUD admin) — pas de prêts / retours MVP.
      match /equipment/{itemId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if isClubAdmin(clubId);
      }

      match /pending_members/{docId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if isClubCoachOrAdmin(clubId);
      }

      // ——— Chat in-app (MVP) ———
      // Création / sync participants : Cloud Functions uniquement.
      // DM : callable `createCoachDm`.
      match /conversations/{conversationId} {
        function conversationDoc() {
          return get(/databases/$(database)/documents/clubs/$(clubId)/conversations/$(conversationId)).data;
        }
        function isConvParticipantFrom(data) {
          return isSignedIn()
            && request.auth.uid in data.get('participantUids', []);
        }
        function canWriteMessagesOn(data) {
          let policy = data.get('writePolicy', 'open');
          return isConvParticipantFrom(data) && (
            policy == 'open'
            || (policy == 'admins_only' && isClubAdmin(clubId))
            || (policy == 'coaches_and_admins' && isClubCoachOrAdmin(clubId))
          );
        }

        /// Groupe multi-users (pas un DM 1:1).
        function isGroupConversation(data) {
          let uids = data.get('participantUids', []);
          return data.get('type', '') != 'dm'
            || (uids is list && uids.size() > 2);
        }

        /// Avatar custom : groupes ouverts uniquement (pas les canaux).
        function canEditConvAvatar(data) {
          return isGroupConversation(data)
            && data.get('writePolicy', 'open') == 'open';
        }

        /// URL download Storage du projet pour `…/chat/{convId}/{uid}/avatar.jpg`.
        function isConversationAvatarDownloadUrl(url) {
          return url is string
            && url.size() > 32
            && url.size() < 2048
            && clubId.matches('^[A-Za-z0-9_-]+$')
            && conversationId.matches('^[A-Za-z0-9_-]+$')
            && url.matches(
              'https://firebasestorage\\.googleapis\\.com/v0/b/viroteam-75303\\.(appspot\\.com|firebasestorage\\.app)/o/clubs%2F'
              + clubId
              + '%2Fchat%2F'
              + conversationId
              + '%2F[A-Za-z0-9_-]+%2Favatar\\.jpg(\\?.*)?$'
            );
        }

        /// `titleOverride` : string ≤ 80, ou null / absent pour effacer.
        function isValidTitleOverride() {
          return !('titleOverride' in request.resource.data)
            || request.resource.data.titleOverride == null
            || (
              request.resource.data.titleOverride is string
              && request.resource.data.titleOverride.size() <= 80
            );
        }

        /// Preview inbox : expéditeur = appelant, rôle connu, prénom ≤ 60, aperçu ≤ 200.
        function isValidPreviewUpdate() {
          return (
              !affectedKeys().hasAny(['lastSenderUid'])
              || request.resource.data.lastSenderUid == request.auth.uid
            )
            && (
              !affectedKeys().hasAny(['lastSenderRole'])
              || request.resource.data.lastSenderRole in ['player', 'coach', 'admin', 'parent']
            )
            && (
              !affectedKeys().hasAny(['lastSenderFirstName'])
              || (
                request.resource.data.lastSenderFirstName is string
                && request.resource.data.lastSenderFirstName.size() <= 60
              )
            )
            && (
              !affectedKeys().hasAny(['lastMessagePreview'])
              || (
                request.resource.data.lastMessagePreview is string
                && request.resource.data.lastMessagePreview.size() <= 200
              )
            );
        }

        allow read: if isConvParticipantFrom(resource.data);
        allow create: if false;
        // Rename : participants autorisés à écrire (pas un lecteur d'un canal
        // admins_only). Avatar : groupe open + URL Storage. Preview inbox :
        // canWriteMessagesOn + valeurs bornées.
        allow update: if isConvParticipantFrom(resource.data) && (
          (
            canWriteMessagesOn(resource.data)
            && affectedKeys().hasOnly(['titleOverride', 'updatedAt'])
            && isValidTitleOverride()
          )
          || (
            canEditConvAvatar(resource.data)
            && affectedKeys().hasOnly(['avatarUrl', 'updatedAt'])
            && isConversationAvatarDownloadUrl(
              request.resource.data.get('avatarUrl', '')
            )
          )
          || (
            canWriteMessagesOn(resource.data)
            && canEditConvAvatar(resource.data)
            && affectedKeys().hasOnly(['titleOverride', 'avatarUrl', 'updatedAt'])
            && isValidTitleOverride()
            && isConversationAvatarDownloadUrl(
              request.resource.data.get('avatarUrl', '')
            )
          )
          || (
            canWriteMessagesOn(resource.data)
            && affectedKeys().hasOnly([
              'lastMessageAt', 'lastMessagePreview', 'lastSenderUid',
              'lastSenderFirstName', 'lastSenderRole', 'updatedAt'
            ])
            && isValidPreviewUpdate()
          )
        );
        allow delete: if false;

        match /messages/{messageId} {
          /// Listes de votes / réactions : inchangées, ou seule la présence de `auth.uid` change.
          function uidListDiffersOnlyByMe(oldList, newList) {
            return oldList is list && newList is list
              && (
                oldList.toSet() == newList.toSet()
                || oldList.toSet().difference(newList.toSet())
                     .union(newList.toSet().difference(oldList.toSet()))
                   == [request.auth.uid].toSet()
              );
          }

          function listOrEmpty(raw) {
            return raw is list ? raw : [];
          }

          /// Pour une clé map (option / emoji), seuls les uids de l’appelant peuvent bouger.
          /// Court-circuit si la clé n'a pas changé (pas de `let` : ils seraient
          /// évalués avant le `||`). Sans ces économies, les emojis × la
          /// comparaison d'ensembles dépassaient la limite de 1000 expressions
          /// des rules et **toute** réaction était refusée (bug constaté le
          /// 28 sept. 2026 par le test « un participant réagit à un message »).
          function mapEntryListOnlyOwn(oldMap, newMap, changed, entryKey) {
            return !changed.hasAny([entryKey])
              || uidListDiffersOnlyByMe(
                listOrEmpty(oldMap.get(entryKey, [])),
                listOrEmpty(newMap.get(entryKey, []))
              );
          }

          /// `pollVotes` : clés o0–o11 uniquement, et chaque liste ≠ que par mon uid.
          function onlyOwnPollVotesUpdate() {
            let oldVotes = resource.data.get('pollVotes', {});
            let newVotes = request.resource.data.get('pollVotes', {});
            let changed = newVotes.diff(oldVotes).affectedKeys();
            return oldVotes is map && newVotes is map
              && changed.hasOnly([
                'o0', 'o1', 'o2', 'o3', 'o4', 'o5',
                'o6', 'o7', 'o8', 'o9', 'o10', 'o11'
              ])
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o0')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o1')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o2')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o3')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o4')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o5')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o6')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o7')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o8')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o9')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o10')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o11');
          }

          /// Réactions autorisées (aligné picker app). Chaque liste ≠ que par mon uid.
          function allowedReactionEmojis() {
            return [
              '👍', '❤️', '😂', '😮', '😢', '🙏',
              '🔥', '👏', '🙌', '💪', '🤝', '✌️', '🤞', '👋', '🫡',
              '😊', '😁', '🤣', '😅', '😉', '😍', '🥰', '😘', '😎',
              '🤔', '🤨', '😐', '😴', '🤯', '😱', '😤', '😡', '🥺',
              '😭', '🤗', '🤩', '🥳', '💯', '✨', '⭐', '🎉',
              '✅', '❌', '⚠️',
              '💙', '💚', '💛', '🧡', '💜', '🖤', '🤍', '💔',
              '⚽', '🏀', '🏐', '🏉', '🎾', '🥇', '🏆', '🎯',
              '⚡', '💡', '📌', '👀', '💬', '📣'
            ];
          }

          /// Emojis par groupes de 8 : un seul `hasAny` par groupe non touché.
          function onlyOwnReactionsUpdate() {
            let oldReactions = resource.data.get('reactions', {});
            let newReactions = request.resource.data.get('reactions', {});
            let changed = newReactions.diff(oldReactions).affectedKeys();
            return oldReactions is map && newReactions is map
              && changed.hasOnly(allowedReactionEmojis())
              && (
                !changed.hasAny(['👍', '❤️', '😂', '😮', '😢', '🙏', '🔥', '👏'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '❤️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😂') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😮') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😢') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🙏') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🔥') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👏')
                )
              )
              && (
                !changed.hasAny(['🙌', '💪', '🤝', '✌️', '🤞', '👋', '🫡', '😊'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🙌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💪') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤝') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✌️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤞') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👋') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🫡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😊')
                )
              )
              && (
                !changed.hasAny(['😁', '🤣', '😅', '😉', '😍', '🥰', '😘', '😎'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😁') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤣') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😅') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😉') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥰') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😘') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😎')
                )
              )
              && (
                !changed.hasAny(['🤔', '🤨', '😐', '😴', '🤯', '😱', '😤', '😡'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤔') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤨') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😐') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😴') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😱') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😤') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😡')
                )
              )
              && (
                !changed.hasAny(['🥺', '😭', '🤗', '🤩', '🥳', '💯', '✨', '⭐'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥺') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😭') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤗') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤩') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥳') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✨') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⭐')
                )
              )
              && (
                !changed.hasAny(['🎉', '✅', '❌', '⚠️', '💙', '💚', '💛', '🧡'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎉') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✅') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '❌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚠️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💙') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💚') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💛') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🧡')
                )
              )
              && (
                !changed.hasAny(['💜', '🖤', '🤍', '💔', '⚽', '🏀', '🏐', '🏉'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💜') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🖤') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💔') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚽') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏀') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏐') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏉')
                )
              )
              && (
                !changed.hasAny(['🎾', '🥇', '🏆', '🎯', '⚡', '💡', '📌', '👀'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎾') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥇') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏆') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '📌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👀')
                )
              )
              && (
                !changed.hasAny(['💬', '📣'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💬') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '📣')
                )
              );
          }

          /// Champs qu'un client peut écrire à la création (liste fermée,
          /// alignée `lib/services/chat_service.dart` et `portal …/chatService.ts`).
          /// `deletedAt`, `deletedByUid`, `editedAt` n'arrivent que par update.
          function messageCreateKeys() {
            return [
              'type', 'text', 'senderUid', 'createdAt', 'reactions',
              'replyToMessageId', 'replyToText', 'replyToSenderUid',
              'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height',
              'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
            ];
          }

          /// Chemin Storage `clubs/{clubId}/chat/{conversationId}/{auth.uid}/<fichier>`
          /// (segment uid = celui que les Storage rules vérifient à l'upload).
          function isOwnChatMediaStoragePath(path) {
            return path is string
              && path.size() < 512
              && clubId.matches('^[A-Za-z0-9_-]+$')
              && conversationId.matches('^[A-Za-z0-9_-]+$')
              && path.matches(
                '^clubs/' + clubId + '/chat/' + conversationId + '/'
                + request.auth.uid + '/[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$'
              );
          }

          /// URL download Storage du projet pour un média chat de l'appelant
          /// (même bucket / même préfixe que `isConversationAvatarDownloadUrl`).
          function isOwnChatMediaDownloadUrl(url) {
            return url is string
              && url.size() > 32
              && url.size() < 2048
              && clubId.matches('^[A-Za-z0-9_-]+$')
              && conversationId.matches('^[A-Za-z0-9_-]+$')
              && url.matches(
                'https://firebasestorage\\.googleapis\\.com/v0/b/viroteam-75303\\.(appspot\\.com|firebasestorage\\.app)/o/clubs%2F'
                + clubId
                + '%2Fchat%2F'
                + conversationId
                + '%2F' + request.auth.uid
                + '%2F[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)(\\?.*)?$'
              );
          }

          /// Dimension image optionnelle : entier 1..20000.
          function isOptionalImageDimension(key) {
            return !(key in request.resource.data)
              || (
                request.resource.data[key] is int
                && request.resource.data[key] > 0
                && request.resource.data[key] <= 20000
              );
          }

          /// `pollVotes` à la création : uniquement des options o0–o11 sans aucun vote.
          function isEmptyPollVotes(votes) {
            return votes is map
              && votes.keys().hasOnly([
                'o0', 'o1', 'o2', 'o3', 'o4', 'o5',
                'o6', 'o7', 'o8', 'o9', 'o10', 'o11'
              ])
              && votes.get('o0', []) == [] && votes.get('o1', []) == []
              && votes.get('o2', []) == [] && votes.get('o3', []) == []
              && votes.get('o4', []) == [] && votes.get('o5', []) == []
              && votes.get('o6', []) == [] && votes.get('o7', []) == []
              && votes.get('o8', []) == [] && votes.get('o9', []) == []
              && votes.get('o10', []) == [] && votes.get('o11', []) == [];
          }

          /// Socle commun à tout message créé par un client.
          function isValidMessageCreateBase() {
            return request.resource.data.keys().hasOnly(messageCreateKeys())
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.createdAt == request.time
              && request.resource.data.get('reactions', {}) == {}
              && (
                !('text' in request.resource.data)
                || (
                  request.resource.data.text is string
                  && request.resource.data.text.size() <= 4000
                )
              );
          }

          allow read: if isConvParticipantFrom(conversationDoc());
          allow create: if canWriteMessagesOn(conversationDoc())
            && isValidMessageCreateBase()
            && (
              (
                request.resource.data.get('type', '') == 'text'
                && request.resource.data.get('text', '') is string
                && request.resource.data.text.size() > 0
                && !request.resource.data.keys().hasAny([
                  'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height',
                  'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
                ])
              )
              || (
                request.resource.data.get('type', '') == 'image'
                && request.resource.data.keys().hasAll(['storagePath', 'downloadUrl'])
                && isOwnChatMediaStoragePath(request.resource.data.storagePath)
                && isOwnChatMediaDownloadUrl(request.resource.data.downloadUrl)
                && (
                  !('thumbUrl' in request.resource.data)
                  || isOwnChatMediaDownloadUrl(request.resource.data.thumbUrl)
                )
                && isOptionalImageDimension('width')
                && isOptionalImageDimension('height')
                && !request.resource.data.keys().hasAny([
                  'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
                ])
              )
              || (
                request.resource.data.get('type', '') == 'poll'
                && conversationDoc().get('participantUids', []).size() > 2
                && request.resource.data.get('pollQuestion', '') is string
                && request.resource.data.pollQuestion.size() > 0
                && request.resource.data.pollQuestion.size() <= 200
                && request.resource.data.get('pollOptions', []) is list
                && request.resource.data.pollOptions.size() >= 2
                && request.resource.data.pollOptions.size() <= 12
                && isEmptyPollVotes(request.resource.data.get('pollVotes', {}))
                && request.resource.data.get('pollAllowMultiple', false) is bool
                && !request.resource.data.keys().hasAny([
                  'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height'
                ])
              )
            )
            && (
              !('replyToMessageId' in request.resource.data)
              || (
                request.resource.data.replyToMessageId is string
                && request.resource.data.replyToMessageId.size() > 0
                && request.resource.data.replyToMessageId.size() <= 128
                && request.resource.data.get('replyToText', '') is string
                && request.resource.data.replyToText.size() > 0
                && request.resource.data.replyToText.size() <= 200
                && (
                  !('replyToSenderUid' in request.resource.data)
                  || (
                    request.resource.data.replyToSenderUid is string
                    && request.resource.data.replyToSenderUid.size() > 0
                    && request.resource.data.replyToSenderUid.size() <= 128
                  )
                )
              )
            );
          // Soft-delete, édition texte (auteur), réactions, ou vote sondage.
          allow update: if isConvParticipantFrom(conversationDoc()) && (
            (
              affectedKeys().hasOnly(['reactions'])
              && resource.data.get('deletedAt', null) == null
              && onlyOwnReactionsUpdate()
            ) || (
              affectedKeys().hasOnly(['pollVotes'])
              && resource.data.get('type', '') == 'poll'
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.get('type', '') == 'poll'
              && onlyOwnPollVotesUpdate()
            ) || (
              affectedKeys().hasOnly(['deletedAt', 'deletedByUid'])
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.deletedByUid == request.auth.uid
              && (
                request.auth.uid == resource.data.senderUid
                || isClubCoachOrAdmin(clubId)
              )
            ) || (
              affectedKeys().hasOnly(['text', 'editedAt'])
              && resource.data.get('deletedAt', null) == null
              && resource.data.get('type', '') == 'text'
              && request.auth.uid == resource.data.senderUid
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
            )
          );
          allow delete: if false;
        }
      }

      // ——— Journal d’activité club (append-only) ———
      // Écrit par les clients (app + portail, `club_activity_service` /
      // `activityService`) et par les Cloud Functions (`logClubActivity`) :
      // on garde la création client mais on borne le contenu.
      match /activity_events/{eventId} {
        allow read: if isClubCoachOrAdmin(clubId);
        allow create: if isClubCoachOrAdmin(clubId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.get('type', '') in [
            'members_added', 'members_removed', 'invitations_sent',
            'events_created', 'event_cancelled', 'team_created',
            'announcement_published'
          ]
          && request.resource.data.get('summary', '') is string
          && request.resource.data.get('summary', '').size() <= 200;
        allow update, delete: if false;
      }

      // ——— Cotisations ———
      match /fee_seasons/{seasonId} {
        allow read: if isClubMember(clubId) || isClubGuardian(clubId);
        allow write: if isClubAdmin(clubId);

        match /member_fees/{memberId} {
          // Admin / coach : list + get. Joueur / parent : sa fiche seulement.
          allow read: if isClubCoachOrAdmin(clubId)
            || ownsMemberDoc(clubId, memberId)
            || isActiveGuardianOf(clubId, memberId);
          // Admin manuel (hors-ligne / aides) ; CB via Cloud Functions (Admin SDK).
          allow write: if isClubAdmin(clubId);

          // Ledger immuable : create admin, update/delete interdits.
          match /payment_events/{eventId} {
            allow read: if isClubCoachOrAdmin(clubId)
              || ownsMemberDoc(clubId, memberId)
              || isActiveGuardianOf(clubId, memberId);
            allow create: if isClubAdmin(clubId);
            allow update, delete: if false;
          }
        }

        match /payment_sessions/{sessionId} {
          allow read: if isClubAdmin(clubId);
          allow write: if false; // Cloud Functions only
        }
      }
    }

    // ————————————————————————————————————————————————————————————
    // Collections racine
    // ————————————————————————————————————————————————————————————

    match /retour_user/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /join_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || isClubAdmin(resource.data.clubId));
      allow update: if isSignedIn()
        && isClubAdmin(resource.data.clubId);
      allow delete: if false;
    }

    // « Mes invitations en attente » : uniquement celles adressées à mon e-mail.
    match /{path=**}/invitations/{inviteId} {
      allow read: if isInvitee();
    }
  }
}
