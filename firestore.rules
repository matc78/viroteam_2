rules_version = '2';

// Règles Firestore ViroTeam v2 — appliquées aux bases `v2-dev` et `v2-prod`
// (voir firebase.json). Tests : `cd rules-tests && npm test`.
//
// Principes (lot 1 sécurité, 2 sept. 2026) :
// - Tout ce qui touche aux rôles, aux comptes liés et aux invitations acceptées
//   passe par les Cloud Functions (Admin SDK). Les clients ne font que lire.
// - Un membre ne modifie que son profil (liste blanche de champs).
// - Une invitation n'est lisible que par le club (coach/admin) ou par l'e-mail invité.
//   La recherche par code passe par la callable `lookupInvitationByCode`.
// - Un parent (guardian) ne voit que les équipes de ses enfants et ce qui les concerne
//   (`users/{uid}.parentTeamIds`, maintenu côté serveur).
//
// Lot 2 (revue chat / parents, 28 sept. 2026) :
// - Un parent ne lit une fiche membre que si c'est son enfant, un membre des
//   équipes de ses enfants (coach, coéquipier) ou un admin (cible de DM).
// - Conversation : rename réservé aux participants qui ont le droit d'écrire,
//   `titleOverride` string ≤ 80 (ou null pour effacer) ; preview inbox bornée.
// - Message : liste fermée de champs à la création, `createdAt` = horodatage
//   serveur, `reactions` / `pollVotes` vides, texte ≤ 4000, médias image
//   obligatoirement dans le bucket du projet sous `…/chat/{conv}/{auth.uid}/`.
// - `activity_events` : `type` parmi la liste connue, `summary` ≤ 200.
//
// Lot 3 (escalade coach → admin, 27 oct. 2026) :
// - Fiche pré-créée par l'encadrement : sans compte lié ni droit.
// - Invitation : ne porte jamais de droit ; `guardian` / `team` réservées aux
//   Cloud Functions.
//
// Une seule clé membre (nov. 2026) :
// - La fiche d'un compte est `members/{auth.uid}` ; rosters, RSVP, guardians,
//   cotisations sont indexés par cet id. Plus d'index `member_accounts` ni de
//   clé RSVP « legacy » sous un ancien memberId.
// - `member_accounts` supprimé (refus par défaut) : les apps ≤ 2.2.15 qui le
//   lisaient sont sous le seuil de mise à jour obligatoire (2.3.0).
//
// Droits purs (nov. 2026, app 2.4.0) :
// - Seule `members/{uid}.permissions` autorise (droit `admin` = tous). Écrite
//   par les Cloud Functions uniquement, comme `coachTeamIds` (relation coach
//   d'équipe), `teamIds`, `accountUid` (seul lien au compte) et l'index
//   `users.memberClubIds`. Plus de champ `role`, `userId` ni `memberId` sur
//   une fiche (la clé est l'id du doc).
// - Demandes de rôle (`join_requests`) supprimées : refus par défaut.
// - Un coach d'équipe agit sur ses équipes seulement, selon
//   `clubs.coachPermissions` (réglé par un admin) : jamais sur un événement
//   « tout le club », modification d'un événement si toutes ses équipes sont
//   les siennes, fiches et invitations de ses équipes (ou pas encore
//   rattachées), modération des conversations de ses équipes.
// - Création de club : callable `createClub`.
//
// Revue sécurité (17 nov. 2026) :
// - Invitation (création, changement d'e-mail) vers une fiche qui porte des
//   droits ou une relation coach : droit Administrateur seulement. Code au
//   format client, `expiresAt` obligatoire et borné, `code` figé.
// - Coach : jamais d'invitation vers la fiche d'un coach (coachTeamIds).
// - Événement multi-équipes : un coach d'une partie des équipes ne retire de
//   l'audience que ses joueurs, sans purger les réponses des autres.
// - RSVP direct : membre de l'audience seulement, valeur connue.
// - Aperçu de conversation : dernier expéditeur, heure serveur, badge
//   cohérent ; auteur cité vérifié. `memberCount` : +1 seulement. Saisons de
//   cotisation : pas de suppression client.

service cloud.firestore {
  match /databases/{database}/documents {

    // ————————————————————————————————————————————————————————————
    // Helpers identité
    // ————————————————————————————————————————————————————————————

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// E-mail du compte connecté, normalisé (minuscules). Chaîne vide si absent.
    function authEmail() {
      return isSignedIn() && request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // ————————————————————————————————————————————————————————————
    // Appartenance et droits (droits purs)
    // ————————————————————————————————————————————————————————————
    //
    // Seule `members/{auth.uid}.permissions` fait foi (écrite par les Cloud
    // Functions uniquement) ; le droit `admin` les implique tous. Être coach
    // d'une équipe est une relation : `members/{auth.uid}.coachTeamIds`
    // (dérivé de `teams.coachIds` par les Functions), dont les capacités sont
    // réglées par `clubs.coachPermissions`. `clubs.adminIds` n'est qu'un index
    // d'audience : il n'autorise rien.

    /// Fiche du compte connecté (une seule clé membre : id = Auth uid).
    function memberDocRef(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubMember(clubId) {
      return isSignedIn() && exists(memberDocRef(clubId));
    }

    /// Données de ma fiche (vide si absente : aucun droit, aucune équipe).
    function myMember(clubId) {
      return isClubMember(clubId) ? get(memberDocRef(clubId)).data : {};
    }

    /// Droit club `permission` (le droit `admin` accorde tout ; `manageFees`
    /// implique `viewFees`, comme `implies` du catalogue partagé).
    function can(clubId, permission) {
      let permissions = myMember(clubId).get('permissions', []);
      return permissions.hasAny(['admin', permission])
        || (permission == 'viewFees' && permissions.hasAny(['manageFees']));
    }

    /// Équipes que j'entraîne.
    function coachedTeamIds(clubId) {
      return myMember(clubId).get('coachTeamIds', []);
    }

    /// Coach d'au moins une équipe.
    function isTeamCoach(clubId) {
      return coachedTeamIds(clubId).size() > 0;
    }

    /// Encadrant : au moins un droit, ou coach d'une équipe.
    function isStaff(clubId) {
      return myMember(clubId).get('permissions', []).size() > 0
        || isTeamCoach(clubId);
    }

    /// Capacité coach `flag` accordée par le club (même défaut que le catalogue
    /// `shared/permissions_catalog.json`).
    function coachFlag(clubId, flag, defaultValue) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data
        .get('coachPermissions', {}).get(flag, defaultValue) == true;
    }

    /// Coach d'équipe et capacité `flag` accordée.
    function coachCan(clubId, flag, defaultValue) {
      return isTeamCoach(clubId) && coachFlag(clubId, flag, defaultValue);
    }

    /// Ajouter / inviter un membre : droit membres ou coach autorisé.
    function canAddMembers(clubId) {
      return can(clubId, 'manageMembers')
        || coachCan(clubId, 'canInvitePlayers', true);
    }

    /// Toutes les équipes `teamIds` sont entraînées par moi (liste non vide).
    function coachesAll(clubId, teamIds) {
      return teamIds is list
        && teamIds.size() > 0
        && teamIds.hasOnly(coachedTeamIds(clubId));
    }

    /// Au moins une des équipes `teamIds` est entraînée par moi.
    function coachesAny(clubId, teamIds) {
      return teamIds is list && teamIds.hasAny(coachedTeamIds(clubId));
    }

    /// Un coach modifie les équipes qu'il encadre, sans toucher à la liste des
    /// coachs (droit équipes) ; ajouter des joueurs suit `canManageTeamRoster`
    /// (vrai par défaut). Retirer un joueur reste au droit équipes.
    function isCoachTeamUpdate(clubId, teamId) {
      let added = request.resource.data.get('playerIds', [])
        .toSet().difference(resource.data.get('playerIds', []).toSet());
      let removed = resource.data.get('playerIds', [])
        .toSet().difference(request.resource.data.get('playerIds', []).toSet());
      return teamId in coachedTeamIds(clubId)
        && !affectedKeys().hasAny(['coachIds', 'name', 'category'])
        && (!affectedKeys().hasAny(['playerIds', 'pendingPlayerIds'])
          || coachFlag(clubId, 'canManageTeamRoster', true))
        && removed.size() == 0;
    }

    // ————————————————————————————————————————————————————————————
    // Parents (guardians)
    // ————————————————————————————————————————————————————————————

    function guardianDoc(clubId, memberId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(memberId)/guardians/$(request.auth.uid);
    }

    function isActiveGuardianOf(clubId, memberId) {
      return isSignedIn()
        && exists(guardianDoc(clubId, memberId))
        && get(guardianDoc(clubId, memberId)).data.status == 'active';
    }

    function isClubGuardian(clubId) {
      return isSignedIn()
        && exists(userDoc())
        && clubId in get(userDoc()).data.get('parentClubIds', []);
    }

    /// Équipes des enfants du parent connecté (maintenu par les Cloud Functions).
    function parentTeamIds() {
      return exists(userDoc()) ? get(userDoc()).data.get('parentTeamIds', []) : [];
    }

    function guardianCanSeeTeams(clubId, teamIds) {
      return isClubGuardian(clubId) && teamIds.hasAny(parentTeamIds());
    }

    /// Fiche membre visible d'un parent (hors ses propres enfants, couverts par
    /// `isActiveGuardianOf`) : membre d'une équipe de ses enfants (coach,
    /// coéquipier du roster) ou admin du club (cible possible d'un DM).
    function guardianCanSeeMember(clubId) {
      return isClubGuardian(clubId) && (
        resource.data.get('teamIds', []).hasAny(parentTeamIds())
        || resource.data.get('permissions', []).hasAny(['admin'])
      );
    }

    /// Annonce visible d'un parent : tout le club, ou une équipe de ses enfants.
    function guardianCanSeeAnnouncement(clubId) {
      return isClubGuardian(clubId) && (
        resource.data.get('targetType', 'Tous les membres') in ['Tous les membres', 'all']
        || (resource.data.get('targetType', '') == 'Équipes'
          && resource.data.get('targetIds', []).hasAny(parentTeamIds()))
      );
    }

    // ————————————————————————————————————————————————————————————
    // Helpers de mutation
    // ————————————————————————————————————————————————————————————

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /// Champs de `member_fees` réservés au crédit CB (Cloud Functions).
    function cardOnlyFeeFields() {
      return [
        'appliedExternalPaymentIds', 'externalPaymentId', 'externalOrderId',
        'paymentIntentId', 'overpaidCents', 'checkoutLock'
      ];
    }

    /// Map audience → Timestamp : seule la clé du compte (= id de sa fiche,
    /// l'Auth uid), posée à l'horodatage serveur.
    function ownServerTimestampOk(field) {
      let after = request.resource.data.get(field, {});
      return !affectedKeys().hasAny([field]) || (
        after.diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid])
        && after[request.auth.uid] == request.time
      );
    }

    /// RSVP : seule la clé du compte (= id de sa fiche, l'Auth uid), avec une
    /// valeur connue des clients (`RsvpStatus` de l'app : `none` = sans
    /// réponse) ou retirée.
    function ownRsvpMapOk() {
      let after = request.resource.data.get('rsvp', {});
      return !affectedKeys().hasAny(['rsvp'])
        || (
          after.diff(resource.data.get('rsvp', {})).affectedKeys().hasOnly([request.auth.uid])
          && (
            !(request.auth.uid in after)
            || after[request.auth.uid] in ['yes', 'maybe', 'no', 'none']
          )
        );
    }

    /// Convoqué de l'événement (`teamMemberIds`) ou coach d'une de ses
    /// équipes (de n'importe quelle équipe si l'événement n'en cible aucune),
    /// comme `PlanningEventDisplay.canRsvpOnEvent` côté app.
    function isEventAudience(clubId) {
      let eventTeams = resource.data.get('teamIds', []);
      return request.auth.uid in resource.data.get('teamMemberIds', [])
        || (eventTeams.size() == 0
          ? isTeamCoach(clubId)
          : coachesAny(clubId, eventTeams));
    }

    /// Le membre ne modifie que ses propres clés : `rsvp`, son horodatage
    /// `rsvpUpdatedAt` et sa vue `seenAt`. Répondre (poser sa clé `rsvp`)
    /// exige d'être dans l'audience de l'événement.
    function onlyOwnAudienceUpdate(clubId) {
      return isClubMember(clubId)
        && affectedKeys().hasOnly(['rsvp', 'rsvpUpdatedAt', 'seenAt', 'updatedAt'])
        && ownRsvpMapOk()
        && (
          !(request.auth.uid in request.resource.data.get('rsvp', {}))
          || !affectedKeys().hasAny(['rsvp'])
          || isEventAudience(clubId)
        )
        && ownServerTimestampOk('rsvpUpdatedAt')
        && ownServerTimestampOk('seenAt');
    }

    /// La map `field` ne fait que perdre des clés (retrait d'une audience).
    function onlyRemovesKeys(field) {
      let diff = request.resource.data.get(field, {}).diff(resource.data.get(field, {}));
      return diff.addedKeys().size() == 0 && diff.changedKeys().size() == 0;
    }

    /// Pas d'écriture du RSVP d'un autre (callable `setEventRsvp`), hors
    /// retrait de clés lors d'une synchronisation d'audience. Ses propres
    /// clés : `rsvp`, `rsvpUpdatedAt` et `seenAt` (sinon une réponse à soi
    /// laissait passer des vues `seenAt` arbitraires).
    function noForeignRsvpWrite() {
      return !affectedKeys().hasAny(['rsvp', 'rsvpUpdatedAt', 'seenAt'])
        || (onlyRemovesKeys('rsvp')
          && onlyRemovesKeys('rsvpUpdatedAt')
          && onlyRemovesKeys('seenAt'))
        || (ownRsvpMapOk()
          && ownServerTimestampOk('rsvpUpdatedAt')
          && ownServerTimestampOk('seenAt'));
    }

    /// Événement d'équipes (ni « tout le club », ni sans équipe) dont le coach
    /// entraîne au moins une équipe.
    function coachesAnyEventTeam(clubId, data) {
      return data.get('allTeams', false) != true
        && coachesAny(clubId, data.get('teamIds', []));
    }

    /// Chemin de la fiche `memberId` du club.
    function memberPathOf(clubId, memberId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(memberId);
    }

    /// Clés retirées de la map `field` par l'écriture.
    function removedMapKeys(field) {
      return request.resource.data.get(field, {})
        .diff(resource.data.get(field, {})).removedKeys();
    }

    /// La fiche `memberId` n'est dans aucune des équipes `teamIds` que je
    /// n'entraîne pas (fiche absente : rien à protéger).
    function onlyInMyTeams(clubId, memberId, teamIds) {
      return !exists(memberPathOf(clubId, memberId))
        || !get(memberPathOf(clubId, memberId)).data.get('teamIds', [])
          .hasAny(teamIds.removeAll(coachedTeamIds(clubId)));
    }

    /// Synchro d'audience (ajout / retrait d'un joueur du roster de son
    /// équipe, app et portail) par un coach qui n'entraîne qu'une partie des
    /// équipes de l'événement : ajouts libres ; au plus un retrait par
    /// écriture, jamais d'un membre d'une autre équipe de l'événement ; les
    /// réponses, horodatages et vues purgés sont ceux d'ids hors de
    /// l'audience restante (pas de purge des joueurs des autres équipes).
    function partialCoachAudienceSyncOk(clubId) {
      let eventTeams = resource.data.get('teamIds', []);
      let audienceAfter = request.resource.data.get('teamMemberIds', []);
      let removed = resource.data.get('teamMemberIds', []).removeAll(audienceAfter);
      return coachesAny(clubId, eventTeams)
        && removed.size() <= 1
        && (removed.size() == 0 || onlyInMyTeams(clubId, removed[0], eventTeams))
        && !removedMapKeys('rsvp').hasAny(audienceAfter)
        && !removedMapKeys('rsvpUpdatedAt').hasAny(audienceAfter)
        && !removedMapKeys('seenAt').hasAny(audienceAfter);
    }

    /// Mise à jour d'un événement par l'encadrement :
    /// - droit planning : tout l'événement ;
    /// - coach autorisé (`canCreateEvents`) de toutes les équipes de
    ///   l'événement, jamais « tout le club » : édition, annulation, audience,
    ///   sans le déplacer vers des équipes qu'il n'entraîne pas ; l'appel suit
    ///   `canTakeAttendance` ;
    /// - coach d'une équipe de l'événement (hors « tout le club ») : appel seul
    ///   (`canTakeAttendance`, spec droits : coach d'une des équipes) ;
    /// - droit équipes, ou coach de toutes les équipes (hors « tout le
    ///   club ») : synchronisation d'audience seule ;
    /// - coach d'une partie des équipes : synchronisation d'audience bornée
    ///   (`partialCoachAudienceSyncOk`).
    function staffEventUpdateOk(clubId) {
      let eventTeams = resource.data.get('teamIds', []);
      let audienceOnly = affectedKeys().hasOnly([
        'teamMemberIds', 'rsvp', 'rsvpUpdatedAt', 'seenAt', 'updatedAt'
      ]);
      return noForeignRsvpWrite() && (
        can(clubId, 'manageEvents')
        || (coachCan(clubId, 'canCreateEvents', true)
          && resource.data.get('allTeams', false) != true
          && coachesAll(clubId, eventTeams)
          && (!affectedKeys().hasAny(['teamIds', 'allTeams'])
            || (coachesAll(clubId, request.resource.data.get('teamIds', []))
              && request.resource.data.get('allTeams', false) != true))
          && (!affectedKeys().hasAny(['attendance'])
            || coachFlag(clubId, 'canTakeAttendance', true)))
        || (affectedKeys().hasOnly(['attendance', 'updatedAt'])
          && coachCan(clubId, 'canTakeAttendance', true)
          && coachesAnyEventTeam(clubId, resource.data))
        || (audienceOnly
          && (can(clubId, 'manageTeams')
            || (resource.data.get('allTeams', false) != true
              && coachesAll(clubId, eventTeams))
            || partialCoachAudienceSyncOk(clubId)))
      );
    }

    /// Création d'événement : droit planning, ou coach autorisé pour ses seules
    /// équipes (jamais « tout le club »).
    function canCreateEvent(clubId) {
      return can(clubId, 'manageEvents')
        || (coachCan(clubId, 'canCreateEvents', true)
          && coachesAll(clubId, request.resource.data.get('teamIds', []))
          && request.resource.data.get('allTeams', false) != true);
    }

    /// Annonce visible / gérable par un coach : cible « Équipes » limitée à ses
    /// équipes (le ciblage club entier ou par catégorie exige le droit annonces).
    function isTeamAnnouncement(clubId, data) {
      return data.get('targetType', '') == 'Équipes'
        && coachesAll(clubId, data.get('targetIds', []));
    }

    function canPublishAnnouncement(clubId, data) {
      return can(clubId, 'manageAnnouncements')
        || (coachCan(clubId, 'canPublishTeamAnnouncements', true)
          && isTeamAnnouncement(clubId, data));
    }

    /// Le titulaire d'une fiche ne modifie que son profil affiché.
    function isOwnProfileUpdate(memberId) {
      return isOwner(memberId)
        && affectedKeys().hasOnly([
          'firstName', 'lastName', 'snapshot', 'dismissedAnnouncementIds', 'updatedAt'
        ]);
    }

    /// Champs d'une fiche jamais écrits par un client : droits, relation coach,
    /// équipes (trigger d'équipe), liaison de compte et re-clé (Cloud
    /// Functions), plus les anciens champs v1 interdits (`role`, `userId`,
    /// `memberId`).
    function protectedMemberFields() {
      return [
        'permissions', 'coachTeamIds', 'teamIds', 'accountUid',
        'formerMemberIds', 'rekeyPendingFrom', 'anonymizedAt',
        'rekeyFailedAt', 'rekeyFailureCount', 'rekeyLastError',
        'rekeyFeeConflictSeasonIds', 'clubDetachedAt',
        'role', 'userId', 'memberId'
      ];
    }

    /// Droit membres : édition d'une fiche, hors champs protégés.
    function isMemberManagerUpdate(clubId) {
      return can(clubId, 'manageMembers')
        && !affectedKeys().hasAny(protectedMemberFields());
    }

    /// Fiche qui ne confère rien à qui la récupère par une invitation : ni
    /// droit, ni relation coach (champs absents = vides).
    function grantsNothing(member) {
      return member.get('permissions', []).size() == 0
        && member.get('coachTeamIds', []).size() == 0;
    }

    /// Coach autorisé sur la fiche `member` : sans droit ni relation coach
    /// (sinon on les récupérerait via l'invitation, ex. la fiche d'un coach
    /// d'une autre équipe) et dans ses équipes, ou sans équipe.
    function coachCanAddMember(clubId, member) {
      let teams = member.get('teamIds', []);
      return coachCan(clubId, 'canInvitePlayers', true)
        && grantsNothing(member)
        && (teams.size() == 0 || coachesAny(clubId, teams));
    }

    /// Fiche `memberId` après écriture (créée dans la même transaction).
    function memberAfter(clubId, memberId) {
      return getAfter(memberPathOf(clubId, memberId)).data;
    }

    /// Inviter vers la fiche `memberId` (ou en changer l'e-mail) revient à la
    /// donner à l'invité : droit Administrateur, ou droit membres / coach
    /// autorisé si la fiche ne confère ni droit ni relation coach (sinon un
    /// responsable membres se donnait une fiche pré-inscrite admin). Sans
    /// fiche visée : droit membres (l'acceptation crée une fiche vierge).
    /// Fiche absente : rien à récupérer pour le droit membres, refus coach.
    function canInviteToMember(clubId, memberId) {
      return can(clubId, 'admin')
        || (memberId == null && can(clubId, 'manageMembers'))
        || (memberId is string && (
          (can(clubId, 'manageMembers')
            && (!existsAfter(memberPathOf(clubId, memberId))
              || grantsNothing(memberAfter(clubId, memberId))))
          || coachCanAddMember(clubId, memberAfter(clubId, memberId))
        ));
    }

    /// Code d'invitation : format des générateurs app / portail (6 caractères
    /// A-Z / 2-9 ; marge jusqu'à 12).
    function isValidInviteCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6,12}$');
    }

    /// Expiration d'invitation : horodatage au plus à 14 jours (les clients
    /// posent maintenant + 7 jours, marge pour l'horloge de l'appareil).
    function isValidInviteExpiry(expiresAt) {
      return expiresAt is timestamp
        && expiresAt <= request.time + duration.value(14, 'd');
    }

    /// Fiche pas encore liée : profil et invitation active éditables par qui
    /// peut ajouter ce membre.
    function isPendingMemberUpdate(clubId) {
      return (can(clubId, 'manageMembers') || coachCanAddMember(clubId, resource.data))
        && !('accountUid' in resource.data)
        && affectedKeys().hasOnly([
          'firstName', 'lastName', 'snapshot', 'activeInvitationId', 'updatedAt'
        ]);
    }

    /// Licence d'un membre : droit membres, ou coach autorisé
    /// (`canEditMemberLicenses`) d'une équipe de la fiche.
    function isLicenseUpdate(clubId) {
      return affectedKeys().hasOnly(['playerInfo', 'updatedAt'])
        && coachCan(clubId, 'canEditMemberLicenses', false)
        && coachesAny(clubId, resource.data.get('teamIds', []));
    }

    /// Fiche pré-créée : aucun compte lié (la liaison passe par
    /// `acceptInvitation`), aucun droit, équipe ni relation coach (Cloud
    /// Functions). Sans ça, un client créait `members/{uidQuelconque}` avec des
    /// droits et ce compte les obtenait via `members/{auth.uid}`. L'id n'est
    /// jamais celui d'un compte existant (une fiche de compte est créée par
    /// les Cloud Functions, avec `accountUid`).
    function isPreCreatedMemberCreate(clubId, memberId) {
      return canAddMembers(clubId)
        && !request.resource.data.keys().hasAny(protectedMemberFields())
        && !exists(/databases/$(database)/documents/users/$(memberId));
    }

    /// Mise à jour d'une invitation membre : `type`, `memberId`, `code` figés,
    /// jamais de droit ni de rôle, pas d'acceptation côté client, expiration
    /// bornée ; fiche visée soumise à `canInviteToMember`. Les invitations
    /// `team` et `guardian` ne se modifient que via les Cloud Functions.
    function isStaffInvitationUpdate(clubId) {
      return resource.data.get('type', 'member') == 'member'
        && canInviteToMember(clubId, resource.data.get('memberId', null))
        && request.resource.data.get('type', 'member') == 'member'
        && request.resource.data.get('status', '') != 'accepted'
        && !affectedKeys().hasAny(['memberId', 'type', 'code', 'role', 'permissions'])
        && (!affectedKeys().hasAny(['expiresAt'])
          || isValidInviteExpiry(request.resource.data.expiresAt));
    }

    /// L'invité (même e-mail) décline son invitation.
    function isInviteeDeclining() {
      return isSignedIn()
        && authEmail() != ''
        && resource.data.get('email', '') == authEmail()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'declined'
        && affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isInvitee() {
      return isSignedIn()
        && authEmail() != ''
        && resource.data.get('email', '') == authEmail();
    }

    /// Invitation rattachée à la fiche du compte connecté (ex. invite parent
    /// vue depuis « Mon parent » sur la fiche club du joueur).
    function isOwnMemberInvite(clubId) {
      return resource.data.get('memberId', '') is string
        && isOwner(resource.data.memberId);
    }

    // ————————————————————————————————————————————————————————————
    // users
    // ————————————————————————————————————————————————————————————

    /// Clubs d'un profil `users` (membre ou parent), maintenus côté serveur.
    function profileClubIds(data) {
      return data.get('memberClubIds', []).concat(data.get('parentClubIds', []));
    }

    match /users/{uid} {
      // get : le titulaire, ou un compte qui partage au moins un club avec lui
      // (membre ou parent) — e-mail, téléphone et liens parent ne sont plus
      // lisibles par n'importe quel compte connecté. `memberClubIds` (seul
      // index des clubs) est écrit par les Cloud Functions qui ajoutent ou
      // retirent un membre. Pas de list global (scraping).
      allow get: if isOwner(uid)
        || (isSignedIn()
          && profileClubIds(resource.data).hasAny(profileClubIds(get(userDoc()).data)));
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.get('parentLinks', []) == []
        && request.resource.data.get('parentClubIds', []) == []
        && request.resource.data.get('parentTeamIds', []) == []
        && request.resource.data.get('memberClubIds', []) == []
        && request.resource.data.get('clubMemberships', []) == []
        // Accès anticipé messagerie : console / Admin SDK uniquement.
        && request.resource.data.get('flags', {}).get('chatMessaging', false) == false;
      // Les index parent et clubs sont maintenus par les Cloud Functions
      // (`clubMemberships`, ancien index v1, reste interdit au client).
      // `legal` est write-once à la création (preuve d’acceptation CGU).
      // `flags.chatMessaging` : pas d’auto-grant (seul Admin SDK / console
      // peut passer false → true). Une écriture client qui remplace `flags`
      // peut perdre le bit (merge de profil) — acceptable.
      allow update: if isOwner(uid)
        && !affectedKeys().hasAny([
          'parentLinks', 'parentClubIds', 'parentTeamIds', 'memberClubIds',
          'clubMemberships', 'deleted', 'legal'
        ])
        && (
          request.resource.data.get('flags', {}).get('chatMessaging', false) != true
          || resource.data.get('flags', {}).get('chatMessaging', false) == true
        );
      // Suppression de compte : callable `deleteMyAccount` (anonymisation).
      allow delete: if false;

      // Mute / unread chat (client).
      match /chatState/{stateId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ————————————————————————————————————————————————————————————
    // clubs
    // ————————————————————————————————————————————————————————————

    match /clubs/{clubId} {
      // Création : callable `createClub` (droits du fondateur côté serveur).
      allow create: if false;
      // L'aperçu « rejoindre par code » passe par `lookupInvitationByCode`.
      allow get: if isSignedIn();
      allow list: if isClubMember(clubId) || isClubGuardian(clubId);
      // `adminIds` (index) n'est modifié que par les Cloud Functions.
      // Compte Stripe Connect : écrit uniquement par les Functions (onboarding,
      // webhook `account.updated`) ; sinon on forçait `complete` ou on
      // pointait vers le compte d'un autre club.
      // - infos du club : droit `manageClubSettings` ;
      // - réglages coach : droit Administrateur ;
      // - paiement en ligne : droit cotisations ;
      // - invitations groupées : droit membres ;
      // - compteur : qui peut ajouter un membre, +1 seulement (transaction
      //   d'ajout de membre app / portail ; les retraits et acceptations
      //   passent par les Cloud Functions).
      allow update: if !affectedKeys().hasAny([
          'adminIds', 'stripeConnectedAccountId', 'stripeConnectStatus'
        ]) && (
          (can(clubId, 'manageClubSettings')
            && !affectedKeys().hasAny([
              'coachPermissions', 'memberCount', 'onlinePaymentEnabled',
              'helloAssoOrganizationSlug', 'lastBulkMemberInviteAt'
            ]))
          || (can(clubId, 'admin')
            && affectedKeys().hasOnly(['coachPermissions', 'updatedAt']))
          || (can(clubId, 'manageFees')
            && affectedKeys().hasOnly([
              'onlinePaymentEnabled', 'helloAssoOrganizationSlug', 'updatedAt'
            ]))
          || (can(clubId, 'manageMembers')
            && affectedKeys().hasOnly(['lastBulkMemberInviteAt', 'updatedAt']))
          || (canAddMembers(clubId)
            && affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.get('memberCount', 0)
              == resource.data.get('memberCount', 0) + 1)
        );
      allow delete: if false;

      // ——— Fiches membres ———
      match /members/{memberId} {
        // get : membres du club, parent de la fiche, ou parent du club limité
        // aux équipes de ses enfants / aux admins (roster via IDs lus sur
        // `teams` — pas de list). Avant : n'importe quelle fiche du club.
        allow get: if isClubMember(clubId)
          || isActiveGuardianOf(clubId, memberId)
          || guardianCanSeeMember(clubId);
        allow list: if isClubMember(clubId);
        // Création : fiche pré-créée sans droit (ajout de membre + invitation).
        // L'arrivée d'un invité passe par la callable `acceptInvitation`, le
        // fondateur par `createClub`.
        allow create: if isPreCreatedMemberCreate(clubId, memberId);
        allow update: if isMemberManagerUpdate(clubId)
          || isPendingMemberUpdate(clubId)
          || isLicenseUpdate(clubId)
          || isOwnProfileUpdate(memberId);
        // Retrait d'un membre : callable `removeMember`.
        allow delete: if false;

        match /guardians/{parentUid} {
          // Lecture : membres du club, le parent lui-même, le titulaire de la fiche.
          // Écriture : Cloud Functions uniquement.
          allow read: if isClubMember(clubId)
            || isOwner(parentUid)
            || isOwner(memberId);
          allow write: if false;
        }
      }

      // ——— Invitations ———
      match /invitations/{inviteId} {
        allow get, list: if canAddMembers(clubId)
          || isInvitee()
          || isOwnMemberInvite(clubId);
        // E-mail obligatoire ; team/guardian uniquement via Cloud Functions.
        // Une invitation ne porte jamais de droit (ils vivent sur la fiche) et
        // ne vise une fiche qui en porte que si l'auteur est admin. Code au
        // format des clients, expiration présente et bornée.
        allow create: if canInviteToMember(clubId, request.resource.data.get('memberId', null))
          && request.resource.data.get('type', 'member') == 'member'
          && request.resource.data.get('email', '') is string
          && request.resource.data.get('email', '').size() > 0
          && request.resource.data.get('status', '') == 'pending'
          && !request.resource.data.keys().hasAny(['role', 'permissions'])
          && isValidInviteCode(request.resource.data.get('code', null))
          && isValidInviteExpiry(request.resource.data.get('expiresAt', null));
        allow update: if isStaffInvitationUpdate(clubId)
          || isInviteeDeclining();
        allow delete: if can(clubId, 'manageMembers');
      }

      // ——— Événements ———
      match /events/{eventId} {
        allow read: if isClubMember(clubId)
          || guardianCanSeeTeams(clubId, resource.data.get('teamIds', []));
        allow create: if canCreateEvent(clubId);
        allow update: if onlyOwnAudienceUpdate(clubId) || staffEventUpdateOk(clubId);
        allow delete: if can(clubId, 'manageEvents');
      }

      // ——— Annonces ———
      match /announcements/{announcementId} {
        allow read: if isClubMember(clubId) || guardianCanSeeAnnouncement(clubId);
        allow create: if canPublishAnnouncement(clubId, request.resource.data);
        allow update: if canPublishAnnouncement(clubId, resource.data)
          && canPublishAnnouncement(clubId, request.resource.data);
        allow delete: if canPublishAnnouncement(clubId, resource.data);
      }

      // ——— Équipes ———
      match /teams/{teamId} {
        allow read: if isClubMember(clubId)
          || guardianCanSeeTeams(clubId, [teamId]);
        // Création / coachs / suppression : droit équipes. Un coach ne peut pas
        // s'ajouter lui-même à `coachIds` (sa relation coach donnerait des
        // capacités sur l'équipe).
        allow create: if can(clubId, 'manageTeams');
        allow update: if can(clubId, 'manageTeams') || isCoachTeamUpdate(clubId, teamId);
        allow delete: if can(clubId, 'manageTeams');
      }

      // Inventaire simple (CRUD admin) — pas de prêts / retours MVP.
      match /equipment/{itemId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if can(clubId, 'manageEquipment');
      }

      match /pending_members/{docId} {
        allow read: if isClubMember(clubId);
        allow create, update, delete: if canAddMembers(clubId);
      }

      // ——— Chat in-app (MVP) ———
      // Création / sync participants : Cloud Functions uniquement.
      // DM : callable `createCoachDm`.
      match /conversations/{conversationId} {
        function conversationDoc() {
          return get(/databases/$(database)/documents/clubs/$(clubId)/conversations/$(conversationId)).data;
        }
        function isConvParticipantFrom(data) {
          return isSignedIn()
            && request.auth.uid in data.get('participantUids', []);
        }
        function canWriteMessagesOn(data) {
          let policy = data.get('writePolicy', 'open');
          return isConvParticipantFrom(data) && (
            policy == 'open'
            || (policy == 'admins_only' && can(clubId, 'manageChat'))
            || (policy == 'coaches_and_admins'
              && (can(clubId, 'manageChat') || isTeamCoach(clubId)))
          );
        }

        /// Groupe multi-users (pas un DM 1:1).
        function isGroupConversation(data) {
          let uids = data.get('participantUids', []);
          return data.get('type', '') != 'dm'
            || (uids is list && uids.size() > 2);
        }

        /// Avatar custom : groupes ouverts uniquement (pas les canaux).
        function canEditConvAvatar(data) {
          return isGroupConversation(data)
            && data.get('writePolicy', 'open') == 'open';
        }

        /// URL download Storage du projet pour `…/chat/{convId}/{uid}/avatar.jpg`.
        function isConversationAvatarDownloadUrl(url) {
          return url is string
            && url.size() > 32
            && url.size() < 2048
            && clubId.matches('^[A-Za-z0-9_-]+$')
            && conversationId.matches('^[A-Za-z0-9_-]+$')
            && url.matches(
              'https://firebasestorage\\.googleapis\\.com/v0/b/viroteam-75303\\.(appspot\\.com|firebasestorage\\.app)/o/clubs%2F'
              + clubId
              + '%2Fchat%2F'
              + conversationId
              + '%2F[A-Za-z0-9_-]+%2Favatar\\.jpg(\\?.*)?$'
            );
        }

        /// `titleOverride` : string ≤ 80, ou null / absent pour effacer.
        function isValidTitleOverride() {
          return !('titleOverride' in request.resource.data)
            || request.resource.data.titleOverride == null
            || (
              request.resource.data.titleOverride is string
              && request.resource.data.titleOverride.size() <= 80
            );
        }

        /// Badge d'aperçu cohérent avec la fiche de l'expéditeur (badge
        /// principal Admin > Entraîneur > Joueur > Membre, `parent` sans
        /// fiche) : jamais un badge plus fort que le sien.
        function isOwnSenderRole(role) {
          return (role == 'admin' && can(clubId, 'admin'))
            || (role == 'coach' && isTeamCoach(clubId))
            || (role in ['player', 'member'] && isClubMember(clubId))
            || role == 'parent';
        }

        /// Preview inbox (écrit par l'app / le portail dans le batch d'envoi,
        /// ou à l'édition de son dernier message) : expéditeur = appelant, et
        /// seul le dernier expéditeur touche l'aperçu ; `lastMessageAt` =
        /// horodatage serveur ; badge cohérent avec sa fiche ; prénom ≤ 60,
        /// aperçu ≤ 200.
        function isValidPreviewUpdate() {
          return (
              !affectedKeys().hasAny(['lastSenderUid'])
              || request.resource.data.lastSenderUid == request.auth.uid
            )
            && (
              !affectedKeys().hasAny([
                'lastMessageAt', 'lastMessagePreview', 'lastSenderFirstName', 'lastSenderRole'
              ])
              || request.resource.data.get('lastSenderUid', '') == request.auth.uid
            )
            && (
              !affectedKeys().hasAny(['lastMessageAt'])
              || request.resource.data.lastMessageAt == request.time
            )
            && (
              !affectedKeys().hasAny(['lastSenderRole'])
              || isOwnSenderRole(request.resource.data.lastSenderRole)
            )
            && (
              !affectedKeys().hasAny(['lastSenderFirstName'])
              || (
                request.resource.data.lastSenderFirstName is string
                && request.resource.data.lastSenderFirstName.size() <= 60
              )
            )
            && (
              !affectedKeys().hasAny(['lastMessagePreview'])
              || (
                request.resource.data.lastMessagePreview is string
                && request.resource.data.lastMessagePreview.size() <= 200
              )
            );
        }

        allow read: if isConvParticipantFrom(resource.data);
        allow create: if false;
        // Rename : participants autorisés à écrire (pas un lecteur d'un canal
        // admins_only). Avatar : groupe open + URL Storage. Preview inbox :
        // canWriteMessagesOn + valeurs bornées.
        allow update: if isConvParticipantFrom(resource.data) && (
          (
            canWriteMessagesOn(resource.data)
            && affectedKeys().hasOnly(['titleOverride', 'updatedAt'])
            && isValidTitleOverride()
          )
          || (
            canEditConvAvatar(resource.data)
            && affectedKeys().hasOnly(['avatarUrl', 'updatedAt'])
            && isConversationAvatarDownloadUrl(
              request.resource.data.get('avatarUrl', '')
            )
          )
          || (
            canWriteMessagesOn(resource.data)
            && canEditConvAvatar(resource.data)
            && affectedKeys().hasOnly(['titleOverride', 'avatarUrl', 'updatedAt'])
            && isValidTitleOverride()
            && isConversationAvatarDownloadUrl(
              request.resource.data.get('avatarUrl', '')
            )
          )
          || (
            canWriteMessagesOn(resource.data)
            && affectedKeys().hasOnly([
              'lastMessageAt', 'lastMessagePreview', 'lastSenderUid',
              'lastSenderFirstName', 'lastSenderRole', 'updatedAt'
            ])
            && isValidPreviewUpdate()
          )
        );
        allow delete: if false;

        match /messages/{messageId} {
          /// Listes de votes / réactions : inchangées, ou seule la présence de `auth.uid` change.
          function uidListDiffersOnlyByMe(oldList, newList) {
            return oldList is list && newList is list
              && (
                oldList.toSet() == newList.toSet()
                || oldList.toSet().difference(newList.toSet())
                     .union(newList.toSet().difference(oldList.toSet()))
                   == [request.auth.uid].toSet()
              );
          }

          function listOrEmpty(raw) {
            return raw is list ? raw : [];
          }

          /// Pour une clé map (option / emoji), seuls les uids de l’appelant peuvent bouger.
          /// Court-circuit si la clé n'a pas changé (pas de `let` : ils seraient
          /// évalués avant le `||`). Sans ces économies, les emojis × la
          /// comparaison d'ensembles dépassaient la limite de 1000 expressions
          /// des rules et **toute** réaction était refusée (bug constaté le
          /// 28 sept. 2026 par le test « un participant réagit à un message »).
          function mapEntryListOnlyOwn(oldMap, newMap, changed, entryKey) {
            return !changed.hasAny([entryKey])
              || uidListDiffersOnlyByMe(
                listOrEmpty(oldMap.get(entryKey, [])),
                listOrEmpty(newMap.get(entryKey, []))
              );
          }

          /// `pollVotes` : clés o0–o11 uniquement, et chaque liste ≠ que par mon uid.
          function onlyOwnPollVotesUpdate() {
            let oldVotes = resource.data.get('pollVotes', {});
            let newVotes = request.resource.data.get('pollVotes', {});
            let changed = newVotes.diff(oldVotes).affectedKeys();
            return oldVotes is map && newVotes is map
              && changed.hasOnly([
                'o0', 'o1', 'o2', 'o3', 'o4', 'o5',
                'o6', 'o7', 'o8', 'o9', 'o10', 'o11'
              ])
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o0')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o1')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o2')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o3')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o4')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o5')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o6')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o7')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o8')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o9')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o10')
              && mapEntryListOnlyOwn(oldVotes, newVotes, changed, 'o11');
          }

          /// `pollVoteTimes` : seule mon entrée change, `{at: horodatage
          /// serveur, edited: bool}`. Absent de l'update = anciens clients.
          function onlyOwnPollVoteTimeUpdate() {
            let oldTimes = resource.data.get('pollVoteTimes', {});
            let newTimes = request.resource.data.get('pollVoteTimes', {});
            let mine = newTimes.get(request.auth.uid, null);
            return !affectedKeys().hasAny(['pollVoteTimes'])
              || (
                oldTimes is map && newTimes is map
                && newTimes.diff(oldTimes).affectedKeys().hasOnly([request.auth.uid])
                && mine is map
                && mine.keys().hasOnly(['at', 'edited'])
                && mine.get('at', null) == request.time
                && mine.get('edited', false) is bool
              );
          }

          /// Réactions autorisées (aligné picker app). Chaque liste ≠ que par mon uid.
          function allowedReactionEmojis() {
            return [
              '👍', '❤️', '😂', '😮', '😢', '🙏',
              '🔥', '👏', '🙌', '💪', '🤝', '✌️', '🤞', '👋', '🫡',
              '😊', '😁', '🤣', '😅', '😉', '😍', '🥰', '😘', '😎',
              '🤔', '🤨', '😐', '😴', '🤯', '😱', '😤', '😡', '🥺',
              '😭', '🤗', '🤩', '🥳', '💯', '✨', '⭐', '🎉',
              '✅', '❌', '⚠️',
              '💙', '💚', '💛', '🧡', '💜', '🖤', '🤍', '💔',
              '⚽', '🏀', '🏐', '🏉', '🎾', '🥇', '🏆', '🎯',
              '⚡', '💡', '📌', '👀', '💬', '📣'
            ];
          }

          /// Emojis par groupes de 8 : un seul `hasAny` par groupe non touché.
          function onlyOwnReactionsUpdate() {
            let oldReactions = resource.data.get('reactions', {});
            let newReactions = request.resource.data.get('reactions', {});
            let changed = newReactions.diff(oldReactions).affectedKeys();
            return oldReactions is map && newReactions is map
              && changed.hasOnly(allowedReactionEmojis())
              && (
                !changed.hasAny(['👍', '❤️', '😂', '😮', '😢', '🙏', '🔥', '👏'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '❤️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😂') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😮') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😢') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🙏') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🔥') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👏')
                )
              )
              && (
                !changed.hasAny(['🙌', '💪', '🤝', '✌️', '🤞', '👋', '🫡', '😊'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🙌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💪') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤝') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✌️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤞') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👋') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🫡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😊')
                )
              )
              && (
                !changed.hasAny(['😁', '🤣', '😅', '😉', '😍', '🥰', '😘', '😎'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😁') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤣') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😅') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😉') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥰') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😘') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😎')
                )
              )
              && (
                !changed.hasAny(['🤔', '🤨', '😐', '😴', '🤯', '😱', '😤', '😡'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤔') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤨') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😐') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😴') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😱') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😤') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😡')
                )
              )
              && (
                !changed.hasAny(['🥺', '😭', '🤗', '🤩', '🥳', '💯', '✨', '⭐'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥺') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '😭') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤗') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤩') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥳') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✨') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⭐')
                )
              )
              && (
                !changed.hasAny(['🎉', '✅', '❌', '⚠️', '💙', '💚', '💛', '🧡'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎉') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '✅') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '❌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚠️') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💙') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💚') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💛') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🧡')
                )
              )
              && (
                !changed.hasAny(['💜', '🖤', '🤍', '💔', '⚽', '🏀', '🏐', '🏉'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💜') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🖤') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🤍') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💔') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚽') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏀') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏐') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏉')
                )
              )
              && (
                !changed.hasAny(['🎾', '🥇', '🏆', '🎯', '⚡', '💡', '📌', '👀'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎾') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🥇') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🏆') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '🎯') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '⚡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💡') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '📌') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '👀')
                )
              )
              && (
                !changed.hasAny(['💬', '📣'])
                || (
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '💬') &&
                  mapEntryListOnlyOwn(oldReactions, newReactions, changed, '📣')
                )
              );
          }

          /// Champs qu'un client peut écrire à la création (liste fermée,
          /// alignée `lib/services/chat_service.dart` et `portal …/chatService.ts`).
          /// `deletedAt`, `deletedByUid`, `editedAt` n'arrivent que par update.
          function messageCreateKeys() {
            return [
              'type', 'text', 'senderUid', 'createdAt', 'reactions',
              'replyToMessageId', 'replyToText', 'replyToSenderUid',
              'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height',
              'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
            ];
          }

          /// Chemin Storage `clubs/{clubId}/chat/{conversationId}/{auth.uid}/<fichier>`
          /// (segment uid = celui que les Storage rules vérifient à l'upload).
          function isOwnChatMediaStoragePath(path) {
            return path is string
              && path.size() < 512
              && clubId.matches('^[A-Za-z0-9_-]+$')
              && conversationId.matches('^[A-Za-z0-9_-]+$')
              && path.matches(
                '^clubs/' + clubId + '/chat/' + conversationId + '/'
                + request.auth.uid + '/[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$'
              );
          }

          /// URL download Storage du projet pour un média chat de l'appelant
          /// (même bucket / même préfixe que `isConversationAvatarDownloadUrl`).
          function isOwnChatMediaDownloadUrl(url) {
            return url is string
              && url.size() > 32
              && url.size() < 2048
              && clubId.matches('^[A-Za-z0-9_-]+$')
              && conversationId.matches('^[A-Za-z0-9_-]+$')
              && url.matches(
                'https://firebasestorage\\.googleapis\\.com/v0/b/viroteam-75303\\.(appspot\\.com|firebasestorage\\.app)/o/clubs%2F'
                + clubId
                + '%2Fchat%2F'
                + conversationId
                + '%2F' + request.auth.uid
                + '%2F[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)(\\?.*)?$'
              );
          }

          /// Dimension image optionnelle : entier 1..20000.
          function isOptionalImageDimension(key) {
            return !(key in request.resource.data)
              || (
                request.resource.data[key] is int
                && request.resource.data[key] > 0
                && request.resource.data[key] <= 20000
              );
          }

          /// `pollVotes` à la création : uniquement des options o0–o11 sans aucun vote.
          function isEmptyPollVotes(votes) {
            return votes is map
              && votes.keys().hasOnly([
                'o0', 'o1', 'o2', 'o3', 'o4', 'o5',
                'o6', 'o7', 'o8', 'o9', 'o10', 'o11'
              ])
              && votes.get('o0', []) == [] && votes.get('o1', []) == []
              && votes.get('o2', []) == [] && votes.get('o3', []) == []
              && votes.get('o4', []) == [] && votes.get('o5', []) == []
              && votes.get('o6', []) == [] && votes.get('o7', []) == []
              && votes.get('o8', []) == [] && votes.get('o9', []) == []
              && votes.get('o10', []) == [] && votes.get('o11', []) == [];
          }

          /// Socle commun à tout message créé par un client.
          function isValidMessageCreateBase() {
            return request.resource.data.keys().hasOnly(messageCreateKeys())
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.createdAt == request.time
              && request.resource.data.get('reactions', {}) == {}
              && (
                !('text' in request.resource.data)
                || (
                  request.resource.data.text is string
                  && request.resource.data.text.size() <= 4000
                )
              );
          }

          allow read: if isConvParticipantFrom(conversationDoc());
          allow create: if canWriteMessagesOn(conversationDoc())
            && isValidMessageCreateBase()
            && (
              (
                request.resource.data.get('type', '') == 'text'
                && request.resource.data.get('text', '') is string
                && request.resource.data.text.size() > 0
                && !request.resource.data.keys().hasAny([
                  'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height',
                  'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
                ])
              )
              || (
                request.resource.data.get('type', '') == 'image'
                && request.resource.data.keys().hasAll(['storagePath', 'downloadUrl'])
                && isOwnChatMediaStoragePath(request.resource.data.storagePath)
                && isOwnChatMediaDownloadUrl(request.resource.data.downloadUrl)
                && (
                  !('thumbUrl' in request.resource.data)
                  || isOwnChatMediaDownloadUrl(request.resource.data.thumbUrl)
                )
                && isOptionalImageDimension('width')
                && isOptionalImageDimension('height')
                && !request.resource.data.keys().hasAny([
                  'pollQuestion', 'pollOptions', 'pollVotes', 'pollAllowMultiple'
                ])
              )
              || (
                request.resource.data.get('type', '') == 'poll'
                && conversationDoc().get('participantUids', []).size() > 2
                && request.resource.data.get('pollQuestion', '') is string
                && request.resource.data.pollQuestion.size() > 0
                && request.resource.data.pollQuestion.size() <= 200
                && request.resource.data.get('pollOptions', []) is list
                && request.resource.data.pollOptions.size() >= 2
                && request.resource.data.pollOptions.size() <= 12
                && isEmptyPollVotes(request.resource.data.get('pollVotes', {}))
                && request.resource.data.get('pollAllowMultiple', false) is bool
                && !request.resource.data.keys().hasAny([
                  'storagePath', 'downloadUrl', 'thumbUrl', 'width', 'height'
                ])
              )
            )
            // Réponse : `replyToText` / `replyToSenderUid` jamais sans
            // `replyToMessageId` ; l'auteur cité est bien celui du message
            // cité (même conversation). `replyToText` (extrait tronqué côté
            // client) n'est que borné.
            && (
              (
                !('replyToMessageId' in request.resource.data)
                && !request.resource.data.keys().hasAny(['replyToText', 'replyToSenderUid'])
              )
              || (
                request.resource.data.replyToMessageId is string
                && request.resource.data.replyToMessageId.size() > 0
                && request.resource.data.replyToMessageId.size() <= 128
                && request.resource.data.get('replyToText', '') is string
                && request.resource.data.replyToText.size() > 0
                && request.resource.data.replyToText.size() <= 200
                && (
                  !('replyToSenderUid' in request.resource.data)
                  || (
                    request.resource.data.replyToSenderUid is string
                    && request.resource.data.replyToSenderUid.size() > 0
                    && request.resource.data.replyToSenderUid.size() <= 128
                    && get(/databases/$(database)/documents/clubs/$(clubId)/conversations/$(conversationId)/messages/$(request.resource.data.replyToMessageId))
                      .data.get('senderUid', '') == request.resource.data.replyToSenderUid
                  )
                )
              )
            );
          // Soft-delete, édition texte (auteur), réactions, ou vote sondage.
          allow update: if isConvParticipantFrom(conversationDoc()) && (
            (
              affectedKeys().hasOnly(['reactions'])
              && resource.data.get('deletedAt', null) == null
              && onlyOwnReactionsUpdate()
            ) || (
              affectedKeys().hasOnly(['pollVotes', 'pollVoteTimes'])
              && resource.data.get('type', '') == 'poll'
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.get('type', '') == 'poll'
              && onlyOwnPollVotesUpdate()
              && onlyOwnPollVoteTimeUpdate()
            ) || (
              affectedKeys().hasOnly(['deletedAt', 'deletedByUid'])
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.deletedByUid == request.auth.uid
              && (
                request.auth.uid == resource.data.senderUid
                || can(clubId, 'manageChat')
                // Coach : modère les conversations de ses équipes seulement.
                || conversationDoc().get('teamId', '') in coachedTeamIds(clubId)
              )
            ) || (
              affectedKeys().hasOnly(['text', 'editedAt'])
              && resource.data.get('deletedAt', null) == null
              && resource.data.get('type', '') == 'text'
              && request.auth.uid == resource.data.senderUid
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
            )
          );
          allow delete: if false;
        }
      }

      // ——— Journal d’activité club (append-only) ———
      // Écrit par les clients (app + portail, `club_activity_service` /
      // `activityService`) et par les Cloud Functions (`logClubActivity`) :
      // on garde la création client mais on borne le contenu.
      match /activity_events/{eventId} {
        allow read: if can(clubId, 'viewActivity');
        // Créé avec l'action qu'il trace (membre, événement, équipe, annonce) :
        // tout encadrant (au moins un droit, ou coach d'équipe).
        allow create: if isStaff(clubId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.get('type', '') in [
            'members_added', 'members_removed', 'invitations_sent',
            'events_created', 'event_cancelled', 'team_created',
            'announcement_published'
          ]
          && request.resource.data.get('summary', '') is string
          && request.resource.data.get('summary', '').size() <= 200;
        allow update, delete: if false;
      }

      // ——— Cotisations ———
      match /fee_seasons/{seasonId} {
        allow read: if isClubMember(clubId) || isClubGuardian(clubId);
        allow create, update: if can(clubId, 'manageFees');
        // Aucun client ne supprime une saison (fiches et journaux de
        // paiement en dépendent) : console / Admin SDK seulement.
        allow delete: if false;

        match /member_fees/{memberId} {
          // Droit `viewFees` : list + get. Joueur / parent : sa fiche seulement.
          allow read: if can(clubId, 'viewFees')
            || isOwner(memberId)
            || isActiveGuardianOf(clubId, memberId);
          // Admin manuel (hors-ligne / aides) ; CB via Cloud Functions (Admin SDK).
          // Les champs de rapprochement CB (idempotence webhook, excédent) ne
          // sont écrits que par les Functions.
          allow create: if can(clubId, 'manageFees')
            && !request.resource.data.keys().hasAny(cardOnlyFeeFields());
          allow update: if can(clubId, 'manageFees')
            && !affectedKeys().hasAny(cardOnlyFeeFields());
          allow delete: if can(clubId, 'manageFees');

          // Ledger immuable : create admin, update/delete interdits. L'entrée
          // est signée par son auteur, horodatée serveur, d'un type manuel
          // (`card_*` = Functions) et cohérente avec la fiche après écriture
          // (même batch / transaction que la mise à jour de `member_fees`).
          match /payment_events/{eventId} {
            allow read: if can(clubId, 'viewFees')
              || isOwner(memberId)
              || isActiveGuardianOf(clubId, memberId);
            allow create: if can(clubId, 'manageFees')
              && request.resource.data.get('actorUid', '') == request.auth.uid
              && request.resource.data.get('createdAt', null) == request.time
              && request.resource.data.get('type', '') in [
                'offline_credit', 'adjust_absolute', 'aid_validated',
                'aid_rejected', 'marked_paid', 'exempted', 'unexempted'
              ]
              && request.resource.data.get('amountPaidCentsAfter', -1)
                == getAfter(/databases/$(database)/documents/clubs/$(clubId)/fee_seasons/$(seasonId)/member_fees/$(memberId))
                  .data.get('amountPaidCents', 0);
            allow update, delete: if false;
          }
        }

        match /payment_sessions/{sessionId} {
          allow read: if can(clubId, 'manageFees');
          allow write: if false; // Cloud Functions only
        }
      }
    }

    // ————————————————————————————————————————————————————————————
    // Collections racine
    // ————————————————————————————————————————————————————————————

    // Config globale de l'app (ex. `mobile` : version minimale exigée).
    // Lue avant connexion (écran de mise à jour obligatoire) ; écrite à la
    // console uniquement.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /retour_user/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // « Mes invitations en attente » : uniquement celles adressées à mon e-mail.
    match /{path=**}/invitations/{inviteId} {
      allow read: if isInvitee();
    }
  }
}
