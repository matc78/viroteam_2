rules_version = '2';

// Storage ViroTeam — logos club + avatars user.
// La maj Firestore (logoUrl / avatarUrl) reste gate admin / owner.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImageUnder2Mb() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Bucket Storage partagé ; vérifier admin sur v2-dev OU v2-prod.
    function isClubAdminOnDb(databaseId, clubId) {
      let clubPath = /databases/$(databaseId)/documents/clubs/$(clubId);
      let accountPath =
        /databases/$(databaseId)/documents/clubs/$(clubId)/member_accounts/$(request.auth.uid);
      let memberPath = exists(accountPath)
        ? /databases/$(databaseId)/documents/clubs/$(clubId)/members/$(firestore.get(accountPath).data.memberId)
        : /databases/$(databaseId)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      return isSignedIn()
        && (
          (exists(clubPath)
            && request.auth.uid in firestore.get(clubPath).data.get('adminIds', []))
          || (exists(memberPath)
            && firestore.get(memberPath).data.role == 'admin')
        );
    }

    function isClubAdmin(clubId) {
      return isClubAdminOnDb('v2-dev', clubId)
        || isClubAdminOnDb('v2-prod', clubId);
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageUnder2Mb();
    }

    match /clubs/{clubId}/logo.jpg {
      allow read: if true;
      allow write: if isClubAdmin(clubId) && isImageUnder2Mb();
    }

    // Reçus de cotisation (PDF générés par les Cloud Functions) : jamais lus
    // directement par les clients — la callable renvoie une URL signée.
    match /receipts/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
