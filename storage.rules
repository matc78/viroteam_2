rules_version = '2';

// Storage ViroTeam — logos club + avatars user.
// La maj Firestore (logoUrl / avatarUrl) reste gate admin / owner.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImageUnder2Mb() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageUnder2Mb();
    }

    // Logos club : lecture publique.
    // Écriture client refusée — les Storage rules ne peuvent pas lire les
    // bases Firestore nommées (v2-dev / v2-prod), seulement (default).
    // Upload via callable Admin SDK `uploadClubLogo` / `uploadClubLogoDev`.
    match /clubs/{clubId}/logo.jpg {
      allow read: if true;
      allow write: if false;
    }

    // Reçus de cotisation (PDF générés par les Cloud Functions) : jamais lus
    // directement par les clients — la callable renvoie une URL signée.
    match /receipts/{allPaths=**} {
      allow read, write: if false;
    }

    // Médias chat : chemin `…/{uid}/{messageId}.jpg`.
    // Les Storage rules ne peuvent pas lire les bases Firestore nommées
    // (v2-dev / v2-prod) → pas de check participantUids ici.
    // Lecture/écriture limitées au propriétaire du segment uid ; les autres
    // participants affichent via `downloadUrl` tokenisé (Firestore).
    match /clubs/{clubId}/chat/{conversationId}/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
